# =============================================================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
#
# Проще всего не копировать этот файл руками, а сгенерировать .env скриптом —
# он сам подберёт свободные порты и уникальные секреты:
#
#     ./scripts/init-project.sh myproject
#
# Если делаешь вручную (cp .envtest .env), ориентируйся на пометки:
#
#     [МЕНЯТЬ]     обязательно своё значение на каждом проекте
#     [УНИКАЛЬНОЕ] обязательно своё И не совпадающее с другими проектами
#                  на этом же сервере
#     [НЕ ТРОГАТЬ] служебное, ломается при изменении
# =============================================================================


# -----------------------------------------------------------------------------
# ИМЯ ПРОЕКТА
# -----------------------------------------------------------------------------
# [УНИКАЛЬНОЕ] Префикс для контейнеров, volume и сети. Из него Docker сделает
# namex-web-1, namex_postgres_data, namex_default. Если два проекта на сервере
# получат одно имя — они будут делить volume с данными.
COMPOSE_PROJECT_NAME=bazar


# -----------------------------------------------------------------------------
# ПОРТЫ НА ХОСТЕ
# -----------------------------------------------------------------------------
# [УНИКАЛЬНОЕ] Порты не должны пересекаться с другими проектами на сервере,
# иначе второй проект не поднимется: "port is already allocated".
# Внутри контейнеров порты всегда стандартные и здесь не настраиваются.
WEB_PORT=8084
DB_PORT=5433


# -----------------------------------------------------------------------------
# DJANGO
# -----------------------------------------------------------------------------
# [УНИКАЛЬНОЕ] Свой ключ на каждый проект. Сгенерировать:
#     openssl rand -base64 64 | tr -d '\n=+/' | cut -c1-50
SECRET_KEY=change_me_generate_your_own_secret_key

# [МЕНЯТЬ] Домены проекта через запятую, без схемы
ALLOWED_HOSTS=example.com,127.0.0.1,localhost

# [МЕНЯТЬ] Те же домены, но СО СХЕМОЙ (https:// или http://)
CSRF_TRUSTED_ORIGINS=https://example.com,http://127.0.0.1

# [МЕНЯТЬ] при необходимости
LANGUAGE_CODE=ru
TIME_ZONE=Asia/Bishkek


# -----------------------------------------------------------------------------
# БАЗА ДАННЫХ
# -----------------------------------------------------------------------------
# [МЕНЯТЬ] Имя базы и пользователя. Физически базы разных проектов изолированы
# (у каждого свой контейнер Postgres и свой volume), но одинаковые имена
# путают при работе с дампами и бэкапами.
POSTGRES_DB=bazar
POSTGRES_USER=bazar_user

# [УНИКАЛЬНОЕ] Свой пароль на каждый проект. Сгенерировать:
#     openssl rand -base64 32 | tr -d '\n=+/' | cut -c1-24
POSTGRES_PASSWORD=change_me_generate_your_own_password

# [НЕ ТРОГАТЬ] Имя сервиса в docker-compose и внутренний порт Postgres.
# Именно по имени "db" контейнеры находят друг друга внутри сети проекта.
POSTGRES_HOST=db
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# PUSH-УВЕДОМЛЕНИЯ (FIREBASE)
# -----------------------------------------------------------------------------
# [МЕНЯТЬ на prod] Путь к JSON-файлу сервисного аккаунта Firebase внутри контейнера.
# Пусто или PUSH_ENABLED=0 — push не отправляются, уведомления копятся в ленте (dev).
FIREBASE_CREDENTIALS_FILE=
PUSH_ENABLED=0
